{
  "schema_version": 1,
  "project": "gerp",
  "source": {
    "repository": {
      "provider": "github",
      "namespace": "dporkka",
      "name": "GERP",
      "default_branch": "main",
      "transport": "https"
    },
    "development": {
      "enabled": true,
      "source_engine": "change_graph",
      "workspace_engine": "jujutsu",
      "max_agent_concurrency": 75,
      "isolation": "firecracker",
      "validation": {
        "required": ["fmt", "vet", "unit", "integration"]
      },
      "integration": "change_dag",
      "auto_rebase": true,
      "auto_merge": false,
      "export": "pull_request"
    }
  }
}
